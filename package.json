{
  "name": "zhihu-connect-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop Q&A agent — M3 local library answers",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace desktop",
    "dev:desktop": "npm run dev --workspace desktop",
    "build:desktop": "npm run build --workspace desktop",
    "typecheck:desktop": "npm run typecheck --workspace desktop",
    "test:desktop": "npm run test --workspace desktop",
    "test:sidecar": "cd services/sidecar && python3 -m pytest -q"
  },
  "engines": {
    "node": ">=22"
  }
}
